# InventCompare – Zugangsdaten für die Quellsysteme
# Diese Datei als .env auf dem Docker-Host ablegen (NICHT ins Git-Repo einchecken).
# Die Web-Oberfläche zeigt nur an, ob Zugangsdaten gesetzt sind – ändern lassen
# sich hier nur nicht-sensible Einstellungen (Sync-Intervall, Filter, Matching).

# Port, unter dem InventCompare per nginx erreichbar ist
NGINX_PORT=9091

# ── Zabbix ───────────────────────────────────────────────────────────────
# URL des JSON-RPC-Endpunkts, z.B. https://zabbix.example.com/api_jsonrpc.php
ZABBIX_URL=
# Bevorzugt: API-Token (Zabbix: Administration -> API-Tokens)
ZABBIX_API_TOKEN=
# Alternativ, falls kein Token verwendet wird:
ZABBIX_USER=
ZABBIX_PASSWORD=
ZABBIX_VERIFY_SSL=true

# ── i-doit ───────────────────────────────────────────────────────────────
# URL des JSON-RPC-Endpunkts, z.B. https://idoit.example.com/src/jsonrpc.php
IDOIT_URL=
# Mandanten-/App-API-Key (i-doit: Systembibliothek -> Mandanten)
IDOIT_API_KEY=
# Benutzer mit Leserechten auf die relevanten CMDB-Objekte
IDOIT_USER=
IDOIT_PASSWORD=
IDOIT_VERIFY_SSL=true

# ── GitLab ───────────────────────────────────────────────────────────────
# Basis-URL der Instanz (OHNE /api/v4), z.B. https://gitlab.example.com
GITLAB_URL=
# Personal-/Group-Access-Token mit Leserechten (Scope: read_api)
GITLAB_API_TOKEN=
GITLAB_VERIFY_SSL=true
